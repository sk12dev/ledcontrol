// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// WLED Device model
model Device {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(255)
  ipAddress  String    @unique @map("ip_address") @db.VarChar(45)
  macAddress String?   @map("mac_address") @db.VarChar(17)
  lastSeen   DateTime? @map("last_seen") @db.Timestamp
  deviceInfo Json?     @map("device_info") // Stores full WLED device info as JSON
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamp

  // Relations
  presets       Preset[]
  userPrefs     UserPreference[]
  wledSegments  WledSegment[]
  cueStepDevices CueStepDevice[]
  buskingPatchEntries BuskingPatchEntry[]

  @@index([ipAddress])
  @@map("devices")
}

// WLED Segment - Named segment on a device for use as cue target
model WledSegment {
  id                Int      @id @default(autoincrement())
  deviceId          Int      @map("device_id")
  name              String   @db.VarChar(255)
  wledSegmentIndex  Int      @map("wled_segment_index") // 0-based, matches WLED seg[id]
  start             Int?     // LED start index (optional, for push to WLED)
  stop              Int?     // LED stop index (optional)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamp

  // Relations
  device         Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  cueStepDevices CueStepDevice[]

  @@unique([deviceId, wledSegmentIndex])
  @@index([deviceId])
  @@map("wled_segments")
}

// Custom Preset model
model Preset {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  color      Int[] // [R, G, B, W] array - stored as PostgreSQL integer array
  brightness Int // 1-255
  deviceId   Int?     @map("device_id")
  userId     Int?     @map("user_id") // For future multi-user support
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamp

  // Relations
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([userId])
  @@map("presets")
}

// Color Preset model - Stores only color values for use in cues
model ColorPreset {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  color     Int[]    // [R, G, B, W] array - stored as PostgreSQL integer array
  userId    Int?     @map("user_id") // For future multi-user support
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp

  @@index([userId])
  @@map("color_presets")
}

// User Preferences model (for future use)
model UserPreference {
  id              Int      @id @default(autoincrement())
  userId          Int?     @map("user_id")
  defaultDeviceId Int?     @map("default_device_id")
  theme           String?  @db.VarChar(50)
  preferences     Json? // Flexible JSON field for additional preferences
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp

  // Relations
  defaultDevice Device? @relation(fields: [defaultDeviceId], references: [id])

  @@index([userId])
  @@map("user_preferences")
}

// Show model - Top-level organizational container for theater shows
model Show {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(255)
  description String?   @db.Text
  userId      Int?      @map("user_id") // For future multi-user support
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp

  // Relations
  cues     Cue[]
  cueLists CueList[]

  @@index([userId])
  @@map("shows")
}

// Cue model - Stores cue metadata for theatre shows
model Cue {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(255)
  description String?   @db.Text
  showId      Int       @map("show_id") // Required - cue belongs to exactly one show
  userId      Int?      @map("user_id") // For future multi-user support
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp

  // Relations
  show       Show      @relation(fields: [showId], references: [id], onDelete: Cascade)
  cueSteps   CueStep[]
  cueListCues CueListCue[]

  @@index([userId])
  @@index([showId])
  @@map("cues")
}

// Art-Net Node model - Recipients of DMX data over UDP
model ArtNetNode {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(255)
  ipAddress  String    @unique @map("ip_address") @db.VarChar(45)
  subnet     Int       @default(0) // 0-15
  universe   Int       @default(0) // 0-15
  lastSeen   DateTime? @map("last_seen") @db.Timestamp
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamp

  // Relations
  dmxFixtures DmxFixture[]

  @@index([ipAddress])
  @@map("art_net_nodes")
}

// DMX Fixture Group - Groups fixtures for batch selection in cues
model DmxFixtureGroup {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(255)
  description String?      @db.Text
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamp

  fixtures    DmxFixture[]

  @@map("dmx_fixture_groups")
}

// DMX Fixture model - Logical DMX device with flexible channel mapping
model DmxFixture {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(255)
  artNetNodeId    Int      @map("art_net_node_id")
  startAddress    Int      @map("start_address") // DMX start channel 1-512
  channelCount    Int      @map("channel_count") // 1-512
  channelPurposes Json     @map("channel_purposes") // Array of purpose strings per channel
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp

  // Relations
  artNetNode       ArtNetNode         @relation(fields: [artNetNodeId], references: [id], onDelete: Cascade)
  cueStepFixtures  CueStepFixture[]
  groups           DmxFixtureGroup[]
  buskingPatchEntries BuskingPatchEntry[]

  @@index([artNetNodeId])
  @@map("dmx_fixtures")
}

// Busking patch: maps fixture numbers (1, 2, 3...) to a Device or DmxFixture for command-line control
model BuskingPatchEntry {
  id             Int   @id @default(autoincrement())
  fixtureNumber  Int   @unique @map("fixture_number")
  deviceId       Int?  @map("device_id")
  dmxFixtureId   Int?  @map("dmx_fixture_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp

  // Relations - exactly one must be set (enforced in application)
  device     Device?     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  dmxFixture DmxFixture? @relation(fields: [dmxFixtureId], references: [id], onDelete: Cascade)

  @@index([fixtureNumber])
  @@map("busking_patch_entries")
}

// CueStepFixture model - Links cue steps to DMX fixtures
model CueStepFixture {
  id               Int      @id @default(autoincrement())
  cueStepId        Int      @map("cue_step_id")
  fixtureId        Int      @map("fixture_id")
  /// When set (length = fixture channel count), cue uses raw DMX instead of color/brightness mapping
  dmxChannelValues Int[]    @default([]) @map("dmx_channel_values")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp

  // Relations
  cueStep CueStep   @relation(fields: [cueStepId], references: [id], onDelete: Cascade)
  fixture DmxFixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@unique([cueStepId, fixtureId])
  @@index([cueStepId])
  @@index([fixtureId])
  @@map("cue_step_fixtures")
}

// CueStep model - Snapshot target per device/fixture (no timing; timing is on CueListCue)
model CueStep {
  id                Int      @id @default(autoincrement())
  cueId             Int      @map("cue_id")
  order             Int      // For sorting steps
  targetColor       Int[]    @map("target_color") // [R, G, B, W] array - empty array means brightness-only
  targetBrightness  Int?     @map("target_brightness") // 1-255, nullable for color-only
  startColor        Int[]    @default([]) @map("start_color") // Empty array = use current device state
  startBrightness   Int?     @map("start_brightness") // Optional, null = use current device state
  turnOff           Boolean  @default(false) @map("turn_off") // If true, turn device off instead of setting color/brightness
  useWledEffect     Boolean  @default(false) @map("use_wled_effect") // If true, set WLED effect instead of color interpolation
  wledEffectId      Int?     @map("wled_effect_id") // 0 to fxcount-1
  wledEffectSpeed   Int?     @map("wled_effect_speed") // sx: 0-255
  wledEffectIntensity Int?   @map("wled_effect_intensity") // ix: 0-255
  wledPaletteId     Int?     @map("wled_palette_id") // pal: 0 to palcount-1
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamp

  // Relations
  cue       Cue           @relation(fields: [cueId], references: [id], onDelete: Cascade)
  cueStepDevices CueStepDevice[]
  cueStepFixtures CueStepFixture[]

  @@index([cueId])
  @@index([cueId, order])
  @@map("cue_steps")
}

// CueStepDevice model - Links cue steps to target devices (whole device or specific segment)
model CueStepDevice {
  id            Int      @id @default(autoincrement())
  cueStepId     Int      @map("cue_step_id")
  deviceId      Int      @map("device_id")
  wledSegmentId Int?     @map("wled_segment_id") // null = whole device (segment 0), set = that segment only
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp

  // Relations
  cueStep     CueStep     @relation(fields: [cueStepId], references: [id], onDelete: Cascade)
  device      Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  wledSegment WledSegment? @relation(fields: [wledSegmentId], references: [id], onDelete: Cascade)

  @@unique([cueStepId, deviceId, wledSegmentId])
  @@index([cueStepId])
  @@index([deviceId])
  @@index([wledSegmentId])
  @@map("cue_step_devices")
}

// CueList model - A list of cues that can be stepped through
model CueList {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(255)
  description String?   @db.Text
  showId      Int       @map("show_id") // Required - cue list belongs to exactly one show
  userId      Int?      @map("user_id") // For future multi-user support
  currentPosition Int   @default(0) @map("current_position") // Index of currently active cue (0-based)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp

  // Relations
  show       Show      @relation(fields: [showId], references: [id], onDelete: Cascade)
  cueListCues CueListCue[]

  @@index([userId])
  @@index([showId])
  @@map("cue_lists")
}

// CueListCue model - Links cues to cue lists with ordering and per-cue timing
model CueListCue {
  id              Int       @id @default(autoincrement())
  cueListId       Int       @map("cue_list_id")
  cueId           Int       @map("cue_id")
  order           Int       // Order within the list (0-based)
  fadeInSeconds   Decimal   @default(0) @map("fade_in_seconds") @db.Decimal(10, 2)
  fadeOutSeconds  Decimal   @default(0) @map("fade_out_seconds") @db.Decimal(10, 2)
  durationSeconds Decimal?  @map("duration_seconds") @db.Decimal(10, 2) // null = infinite
  /// Seconds between consecutive starts of the same cue; 0 = no repeat
  repeatIntervalSeconds Decimal @default(0) @map("repeat_interval_seconds") @db.Decimal(10, 2)
  /// Total times to play this cue (including the first). null = infinite when repeat interval > 0
  repeatTotalPlays Int?     @map("repeat_total_plays")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp

  // Relations
  cueList CueList @relation(fields: [cueListId], references: [id], onDelete: Cascade)
  cue     Cue     @relation(fields: [cueId], references: [id], onDelete: Cascade)

  @@unique([cueListId, order]) // Ensure unique ordering within a list
  @@index([cueListId])
  @@index([cueId])
  @@map("cue_list_cues")
}
